{
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh *)",
      "Bash(scripts/test-integration.sh *)",
      "Bash(scripts/run-app.sh)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swift format *)",
      "Bash(swift package *)",
      "Bash(xcodebuild *)",
      "Bash(xcodegen *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(**/*.pbxproj)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh", "timeout": 600 }]
      }
    ]
  }
}
