// Code signing. Defaults to ad-hoc ("-"), which works anywhere but makes macOS ask for the
// microphone again after every rebuild. Put your own identity in Signing.local.xcconfig (git-ignored):
//
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
#include? "Signing.local.xcconfig"
